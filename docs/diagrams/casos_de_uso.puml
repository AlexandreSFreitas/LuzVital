@startuml casos_de_uso
' LuzVital — Diagrama de Casos de Uso (escopo total)
' Fonte de verdade da tabela: docs/agile/03_CASOS_DE_USO.md
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FFF8E1
  BorderColor #8D6E00
}

actor "Paciente" as Paciente
actor "Contato de apoio\n(familiar/cuidador)" as Contato
actor "Equipe de\nhome care" as Equipe
actor "Operador\nda central" as Operador
actor "Administrador" as Admin

actor "Simulador de\ninterrupções" as Simulador <<sistema>>
actor "Distribuidora\nde energia\n(futuro)" as Distribuidora <<externo>>
actor "Dispositivo de\nmonitoramento\n(futuro)" as Dispositivo <<externo>>
actor "Serviço de\nmensagens\n(futuro)" as Mensagens <<externo>>

rectangle "LuzVital" {
  usecase "UC01 Cadastrar paciente\n(endereço e região)" as UC01
  usecase "UC02 Registrar\nconsentimento" as UC02
  usecase "UC03 Gerenciar equipamentos\ne autonomia da bateria" as UC03
  usecase "UC04 Gerenciar contatos\ne ordem de acionamento" as UC04
  usecase "UC05 Manter catálogo\nde equipamentos" as UC05
  usecase "UC06 Manter regiões" as UC06
  usecase "UC07 Registrar interrupção\nde energia" as UC07
  usecase "UC08 Identificar pacientes\nafetados" as UC08
  usecase "UC09 Gerar alertas\npriorizados" as UC09
  usecase "UC10 Receber alerta" as UC10
  usecase "UC11 Confirmar alerta" as UC11
  usecase "UC12 Registrar ação\nde apoio" as UC12
  usecase "UC13 Acompanhar painel\nda interrupção" as UC13
  usecase "UC14 Encerrar interrupção" as UC14
  usecase "UC15 Consultar orientações\nde emergência (SAMU 192)" as UC15
  usecase "UC16 Escalar alerta\nsem resposta" as UC16
  usecase "UC17 Enviar sinal\nde funcionamento" as UC17
  usecase "UC18 Detectar ausência\nde sinal" as UC18
  usecase "UC19 Consultar indicadores" as UC19
  usecase "UC20 Autenticar-se" as UC20
  usecase "UC21 Gerenciar usuários\ne perfis" as UC21
}

Equipe --> UC01
Equipe --> UC03
Equipe --> UC04
Paciente --> UC02
Equipe --> UC02
Paciente --> UC15

Admin --> UC05
Admin --> UC06
Admin --> UC19
Admin --> UC21

Operador --> UC07
Operador --> UC12
Operador --> UC13
Operador --> UC14
Operador --> UC19
Simulador --> UC07
UC07 <-- Distribuidora

Contato --> UC10
Contato --> UC11
Contato --> UC12
Contato --> UC15
Equipe --> UC10
Equipe --> UC11
Equipe --> UC12
UC10 <-- Mensagens

Dispositivo --> UC17
Dispositivo --> UC18

Contato --> UC20
Equipe --> UC20
Operador --> UC20
Admin --> UC20

UC01 ..> UC02 : <<include>>
UC07 ..> UC08 : <<include>>
UC08 ..> UC09 : <<include>>
UC18 ..> UC07 : <<include>>
UC15 ..> UC10 : <<extend>>
UC16 ..> UC09 : <<extend>>
@enduml
