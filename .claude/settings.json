{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(java -version)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw test)",
      "Bash(./mvnw compile *)",
      "Bash(./mvnw compile)",
      "Bash(mvnw.cmd test *)",
      "Bash(mvnw.cmd test)",
      "Bash(python -m pytest *)",
      "Bash(python -m pytest)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(docker *)",
      "Bash(gh *)",
      "Bash(sql *)",
      "Bash(rm *)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/wallet/**)",
      "Read(**/Wallet_*/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/secrets/**)",
      "Read(**/credentials*.json)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(irm * | iex)"
    ]
  }
}
